  - m_Id: 690870185984
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 724957294592
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 13060448239738880
    m_Localized: "WASD - \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.\r\n\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      E \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u0434\u0432\u0435\u0440\u0438, \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u0438  \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438\r\n\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      Q \u0447\u0442\u043E\u0431\u044B \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u044E.\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      F \u0447\u0442\u043E\u0431\u044B \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432 \u0440\u0443\u043A\u0430\u0445.
      \r\n\r\n\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u0430
      \u043C\u044B\u0448\u0438 (\u0438\u043B\u0438 1 2 3 4)  \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u044F\u0447\u0435\u0439\u043A\u0443
      \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 13060700061556736
    m_Localized: "\u041F\u043B\u0430\u043D \u043F\u043E\u0431\u0435\u0433\u0430:\r\n\r\n\u041D\u043E\u0447\u044C\u044E
      \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F
      \u043F\u043E \u0434\u043E\u043C\u0443. \r\n\u0421\u043E\u0431\u0440\u0430\u0442\u044C
      6 \u043A\u043E\u0440\u043E\u0431\u043E\u043A.\r\n\u041F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u043B\u0435\u0441\u0435\u043D\u043A\u0443 \u0438\u0437 \u043A\u043E\u0440\u043E\u0431\u043E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0432\u044B\u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 13060830516994048
    m_Localized: "\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u043E
      \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u043A\u0430\u043C\u0435\u0440:\r\n\r\n1)
      \u041F\u0440\u0438\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443
      \u043A \u0443\u0433\u043B\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u044B\r\n2)
      \u0412\u0437\u044F\u0442\u044C \u043F\u043B\u0430\u043D\u0448\u0435\u0442 \u043A\u0430\u043C\u0435\u0440
      \u0432 \u0440\u0443\u043A\u0438\r\n3) \u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C\r\n\r\n\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C,
      \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u0441\u0435\u0440\u0446\u0438\u0444\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u044B
      \u043A\u0430\u043C\u0435\u0440 \u0432\u0438\u0434\u0435\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F.\r\n\r\n\u0422\u0430\u043A
      \u0436\u0435, \u0435\u0441\u043B\u0438 \u043A\u0430\u043C\u0435\u0440\u0430
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E,
      \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      F \u0438 \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u0430 \u043C\u044B\u0448\u0438
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u0443\u044E
      \u043A\u0430\u043C\u0435\u0440\u0443 \u0438 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 13060948565680128
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u0434\u043E\u043C\u0435 \u0436\u0438\u0432\u0435\u0442
      \u0441\u043E\u0431\u0430\u043A\u0430.\r\n\r\n\u041B\u0443\u0447\u0448\u0435
      \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0442\u044C\u0441\u044F \u0435\u0439
      \u043D\u0430 \u0433\u043B\u0430\u0437\u0430.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 13061208377647104
    m_Localized: "\u041F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0441\u044C.\r\n\r\n\u041A
      \u0442\u0435\u0431\u0435 \u0441\u043A\u043E\u0440\u043E \u043F\u0440\u0438\u0434\u0443\u0442
      \u0433\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 13077440430596096
    m_Localized: "\u043D\u0430\u0436\u043C\u0438 F \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 13060990374502400
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043E\u0431\u0438\u0442\u0430\u0435\u0442
      \u0433\u043D\u0435\u0437\u0434\u043E\u0432\u043E\u0439 \u043C\u043E\u043D\u0441\u0442\u0440.\r\n\r\n\u041D\u0435
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439 \u0435\u0433\u043E.\r\n\r\n\u041F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u0435\u043C\u0443 \u044F\u0431\u043B\u043E\u0447\u043A\u043E
      \u0443 \u0434\u0432\u0435\u0440\u0438.\r\n\r\n\u0418\u043D\u0430\u0447\u0435
      \u043E\u043D\u043E \u0441\u0430\u043C\u043E \u0432\u044B\u0439\u0434\u0435\u0442
      \u0438\u0441\u043A\u0430\u0442\u044C \u0435\u0434\u0443.\r\n\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 13134840212910080
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
